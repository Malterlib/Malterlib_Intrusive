Import "../Core/Lib_Malterlib.MTarget"

Property.MalterlibBoostModules =+ ["intrusive", "static_assert", "assert", "move", "preprocessor"]
{
	!!MalterlibEnableInternalTests true
}

%Group "{Malterlib}/{Lib_Malterlib_Intrusive}"
{
	%Group "Intrusive"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Intrusive/^*"
		}
		%File "Source/^*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Intrusive: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Intrusive"
	{
		!!MalterlibLibrary_Intrusive true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Intrusive: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Intrusive true
	}
}

%Group "{Test}/{Malterlib_Intrusive}"
{
	Compile
	{
		!!CompileDialect "C"
		Warnings_MissingCommaVariadicParam false
		{
			!!Compiler "Clang"
		}
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Intrusive"
	MalterlibTestFiles_Malterlib_Intrusive: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestExtraGroups_Malterlib_Intrusive: [string] = ["{Test}/{Malterlib_Intrusive}"]
}
